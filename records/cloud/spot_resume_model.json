{
 "what": "cost of a resumable Spot run of the full check (full-spot) as a function of the mean time between reclaims M, by simulation of the design attempt by attempt, with closed forms beside it",
 "how_to_reproduce": "python3 analysis/spot_resume_model.py --out records/cloud/spot_resume_model.json",
 "inputs_as_of": "2026-11-21",
 "seed": 20261121,
 "runs_per_point": 4000,
 "runs_per_point_in_thresholds_and_sensitivity": 1000,
 "inputs": {
  "setup_h": {
   "value": 0.1,
   "label": "estimated",
   "source": "setup.tsv of the pilot and six rehearsals: 76-137 s from guest start to first compile (measured); plus about 236 s of boot and teardown, from rehearsal 6's 1,487 s billed against 1,251 s elapsed in the guest (derived)",
   "meaning": "boot, setup and teardown of one attempt's fresh machine, hours"
  },
  "restore_before_seal_h": {
   "value": 0.15,
   "label": "guess",
   "source": "no restore has been timed; about 140 GB of compiled files, about 41 GB as zstd parts (0.23 MB a module in the rehearsals' keep archives, measured small)",
   "meaning": "restore of the whole tree's parts before the seal, hours; scaled by the share of the build saved"
  },
  "restore_after_seal_h": {
   "value": 0.25,
   "label": "guess",
   "source": "restore of every part plus the seal's steps again on the new machine; the seal took 28 s on 1,663 modules (rehearsal 6 phases.tsv) and has not been timed at full scale",
   "meaning": "restore plus the seal's steps again, on an attempt that starts after the seal, hours"
  },
  "build_h": {
   "value": 15.6,
   "label": "estimated",
   "source": "records/cloud/replay_cost.json whole_run, expected (low 13.7, high 17.9)",
   "meaning": "the build, hours, including the top of the import graph"
  },
  "top_h": {
   "value": 0.4,
   "label": "estimated",
   "source": "allowance for the top of the import graph in records/cloud/replay_cost.json (0.2 / 0.4 / 1.0); nothing with an import closure above 17,860 has been compiled",
   "meaning": "the part of the build at the top of the import graph that is treated as units that cannot be split, hours"
  },
  "top_units": {
   "value": 1,
   "label": "guess",
   "source": "modelling choice: one unit is the harshest reading (a reclaim anywhere in it loses all of it)",
   "meaning": "how many equal units the top of the import graph is split into"
  },
  "ckpt_min": {
   "value": 10.0,
   "label": "setting",
   "source": "GCP_SPOT_CKPT_EVERY = 600 s",
   "meaning": "minutes between parts during the build"
  },
  "ckpt_lag_min": {
   "value": 1.0,
   "label": "guess",
   "source": "settle margin 5 s, then compressing and uploading about 10 minutes of compiled output (about 1.4 GB, about 0.4 GB as a part); upload throughput to the bucket has not been measured",
   "meaning": "minutes from a part's cut to its manifest upload finishing, during which its work is not yet saved"
  },
  "seal_h": {
   "value": 0.25,
   "label": "guess",
   "source": "28 s on 1,663 modules in rehearsal 6 (measured small); not timed at full scale",
   "meaning": "the seal, hours (cannot be split)"
  },
  "c2_plain_h": {
   "value": 0.1,
   "label": "guess",
   "source": "the plain and deep axiom checks together have an allowance of 0.2 / 0.5 / 2.0 h (analysis/pilot_estimate.py); 5 s in rehearsal probe mode; the split between them is a guess",
   "meaning": "the plain axiom check, hours (cannot be split)"
  },
  "trials_h": {
   "value": 0.25,
   "label": "estimated",
   "source": "the full run spends the first 15 minutes of its replay on trials (docs/cloud-notes.md); about 90 s each in the rehearsals",
   "meaning": "the replay trials and the choice of job count, hours (cannot be split)"
  },
  "c2_deep_h": {
   "value": 0.5,
   "label": "estimated",
   "source": "allowance 0.5 h expected, 2 h high (time box 7,200 s); never run on the full tree",
   "meaning": "the deep axiom check, hours (cannot be split)"
  },
  "replay_h": {
   "value": 8.8,
   "label": "estimated",
   "source": "8.5 h from the fit in records/cloud/replay_cost.json, plus the rehearsal's 4-8 % excess",
   "meaning": "the main replay, hours"
  },
  "replay_save_min": {
   "value": 20.0,
   "label": "setting",
   "source": "GCP_SPOT_CONFIRM_EVERY = 1200 s: the replay's results are saved only after a full hash of the compiled files, the toolchain copy and the library files on the same machine confirms that nothing changed (docs/cloud-notes.md section 10)",
   "meaning": "minutes between saves of the replay's results"
  },
  "confirm_min": {
   "value": 5.0,
   "label": "guess",
   "source": "a full hash of about 0.13 TB of compiled files with four processes while the replay runs; never timed at full scale (the end check's hash took 3 s on 1,663 modules in rehearsal 6)",
   "meaning": "minutes one confirming hash takes: results written during it wait for the next save, and each axiom check ends with one"
  },
  "confirm_share": {
   "value": 0.125,
   "label": "setting",
   "source": "four hashing processes on a machine of 32 threads",
   "meaning": "share of the machine a confirming hash takes from the replay while it runs"
  },
  "deadline_margin_h": {
   "value": 0.25,
   "label": "setting",
   "source": "the guest's deadline is 900 s before the attempt's maximum run time (cloud/gcp/pilot_local.sh)",
   "meaning": "the guest's own deadline comes this long before Google deletes the machine, hours"
  },
  "pause_winddown_h": {
   "value": 0.1,
   "label": "guess",
   "source": "last part, uploads, status PAUSED, and the watcher's delete after the guest's deadline",
   "meaning": "billed time after the guest's deadline in an attempt that pauses, hours"
  },
  "detect_lag_h": {
   "value": 0.02,
   "label": "guess",
   "source": "watch polls every 45 s (facts on the launcher), then deletes and verifies",
   "meaning": "time after a reclaim that the ledger still counts (Google bills nothing for it), hours"
  },
  "gap_h": {
   "value": 0.1,
   "label": "guess",
   "source": "the watcher notices, closes the row and creates the next machine; capacity waits are not modelled",
   "meaning": "wall-clock time between attempts (counts towards the give-up time; bills nothing), hours"
  },
  "max_attempts": {
   "value": 24,
   "label": "setting",
   "source": "GCP_SPOT_MAX_ATTEMPTS",
   "meaning": "the run pauses when this many attempts have been started"
  },
  "noprogress_limit": {
   "value": 3,
   "label": "setting",
   "source": "the pause rules of `watch` (cloud/gcp/pilot_local.sh)",
   "meaning": "the run pauses after this many attempts in a row that saved nothing"
  },
  "min_attempt_h": {
   "value": 1.5,
   "label": "setting",
   "source": "GCP_SPOT_MIN_ATTEMPT_SECONDS = 5400",
   "meaning": "no attempt shorter than this is started, hours"
  },
  "giveup_h": {
   "value": 120.0,
   "label": "setting",
   "source": "GCP_SPOT_GIVEUP_HOURS",
   "meaning": "no attempt starts later than this after the first launch, hours"
  },
  "mode_limit_h": {
   "value": 42.0,
   "label": "setting",
   "source": "151200 s for full-spot (cloud/gcp/pilot_local.sh)",
   "meaning": "the longest attempt, hours"
  },
  "cap_usd": {
   "value": 50.0,
   "label": "setting",
   "source": "docs/cloud-notes.md section 8.6",
   "meaning": "the spending cap, USD"
  },
  "spent_usd": {
   "value": 9.86,
   "label": "measured",
   "source": "the launcher's ledger after the sixth rehearsal (docs/cloud-notes.md section 8.6)",
   "meaning": "recorded spend before the run, USD"
  },
  "reserve_usd": {
   "value": 1.0,
   "label": "setting",
   "source": "GCP_SPOT_RESERVE_USD: held back for bucket storage of the parts",
   "meaning": "held back from the cap, USD"
  },
  "spot_list_usd_h": {
   "value": 1.1,
   "label": "estimated",
   "source": "us-central1 list prices read 2026-11-20/21: machine 1.0136 Spot, disks 0.083, address 0.0025 (1.097-1.105 all-in); Spot prices can change daily",
   "meaning": "what Google charges for an hour of a Spot attempt, all in, USD"
  },
  "spot_ledger_usd_h": {
   "value": 1.2,
   "label": "setting",
   "source": "GCP_SPOT_RATE_USD_PER_HOUR",
   "meaning": "what the ledger and the cap count for an hour of a Spot attempt, USD"
  },
  "od_list_usd_h": {
   "value": 1.87,
   "label": "estimated",
   "source": "us-central1 list prices: 1.862-1.868 all-in on demand (docs/cloud-notes.md)",
   "meaning": "on demand, list, all in, USD an hour"
  },
  "od_ledger_usd_h": {
   "value": 2.0,
   "label": "setting",
   "source": "GCP_RATE_USD_PER_HOUR default (docs/cloud-notes.md section 8.6)",
   "meaning": "on demand, as the ledger counts it, USD an hour"
  },
  "shape": {
   "value": 1.0,
   "label": "guess",
   "source": "1 is a Poisson process; Google publishes nothing on how reclaims are spread over a machine's life",
   "meaning": "shape of the Weibull time to reclaim of one attempt (1 = exponential); the mean is M whatever the shape"
  }
