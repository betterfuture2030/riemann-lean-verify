# targets/grh-compact/target.env - the compact edition of the shorter proof published on 2026-11-25 at
# https://github.com/lsernau/grh-lean (its README: "a shorter version" of the default target's proof).
#
# First written from the repository's pages on 2026-11-26, before anything was fetched. Steps 01 to 03
# were first run on 2026-11-27; what that changed here: the SHA-256 below, TGT_LIBS_OUTSIDE_SRC, and the
# second smoke module (chosen from the import graph made the same day).
#
# Only the directory grh-compact/ of the commit is exported. Its lakefile.toml has
# defaultTargets = ["Lib", "New", "Main"], which are all under src/. A fourth library, Challenge, has
# srcDir = ".." (from the package's srcDir, src): its one file, Challenge.lean, is beside src/, in the
# project's own directory. It states the five theorems with 'sorry' for the tool Comparator, nothing
# imports it and it is not a default target, so the build does not compile it. A Comparator run would,
# and is not covered here.
TGT_SOURCE_KIND=git
TGT_GIT_URL=https://github.com/lsernau/grh-lean
TGT_GIT_COMMIT=72fead102f663d5c7a407964a13dc0cf9d977207
TGT_GIT_SUBDIR=grh-compact
TGT_TARBALL_NAME=source.tar
# Printed by the first fetch, on 2026-11-27 (01_fetch.sh; 807 files with 7,507,927 bytes of contents, in a
# tar file of 8,130,560 bytes).
TGT_TARBALL_SHA256=c4cf2fabe540f758dd8637b5f3aeaed85f840b0829db3ef3c3b45a48abde91a2
TGT_ARCHIVE_PREFIX=grh-compact/
TGT_SRC_DIR=src
TGT_LIBS_OUTSIDE_SRC=Challenge
TGT_ARCHIVE_ALLOW_EXEC=0
TGT_RECORDS_DIR=targets/grh-compact/records
TGT_ROOT_MODULE=Main
TGT_THEOREMS="riemannHypothesis riemannZeta_eq_zero_re LFunction_ne_zero_of_half_lt_re LFunction_eq_zero_re LFunction_eq_zero_re_of_isPrimitive"
TGT_PRIMARY_THEOREM=riemannHypothesis
TGT_STATEMENT_CONST=RiemannHypothesis
# The module Mathlib defines that constant in at the default target's revision. This project pins another
# revision of Mathlib; if the constant has moved, the axiom check will say so and this line is what to change.
TGT_STATEMENT_CONST_MODULE=Mathlib.NumberTheory.LSeries.RiemannZeta
TGT_REPORT_CONSTS="RiemannHypothesis riemannZeta DirichletCharacter.LFunction"
TGT_PROTECTED_NAMES="RiemannHypothesis riemannZeta LFunction"
# Statements (16 lines) imports only Mathlib. Lib.General.Analysis.ZpowSum (91 lines) imports one module of
# the project, Lib.General.LinearAlgebra.Base (155 lines), by the import graph made on 2026-11-27. So the
# smoke build compiles three modules of the project.
TGT_SMOKE_TARGETS="Statements Lib.General.Analysis.ZpowSum"
# The project pins Mathlib by revision; whether that revision is an official tag has not been looked up.
TGT_MATHLIB_TAG=
